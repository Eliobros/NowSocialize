# Copiar para /usr/local/etc/mediamtx/live.env e preencher (chmod 600 live.env).
# Estes valores têm de ser IGUAIS aos do .env do app SocializeNow.

# Base local do app (mesma máquina do MediaMTX).
API_BASE_URL=http://127.0.0.1:3002

# = MEDIA_SERVER_SECRET do .env do app (webhooks validate-key / publish-done).
MEDIA_SECRET=colar-aqui

# Credencial da ponte ffmpeg (leitura de live/* + publicação em public/*).
# = MTMX_BRIDGE_USER / MTMX_BRIDGE_PASS do .env do app.
# Usar só caracteres seguros em URL (letras, números). Sem @ : / ? #.
MTMX_BRIDGE_USER=bridge
MTMX_BRIDGE_PASS=colar-aqui
